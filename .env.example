AGENTPOST_ENVIRONMENT=development
AGENTPOST_DATABASE_URL=postgresql+psycopg://agentpost:agentpost@db:5432/agentpost
AGENTPOST_STORAGE_PATH=/data/attachments
AGENTPOST_LOG_LEVEL=INFO
AGENTPOST_API_KEY_PEPPER=replace-in-production
AGENTPOST_HUMAN_API_KEY_PEPPER=replace-in-production
AGENTPOST_CURSOR_SECRET=replace-in-production
AGENTPOST_PAIRING_SECRET=replace-in-production
AGENTPOST_HUMAN_AUTH_SECRET=replace-in-production
AGENTPOST_HUMAN_MFA_ENCRYPTION_KEY=replace-in-production
AGENTPOST_OAUTH_TOKEN_PEPPER=replace-in-production
AGENTPOST_PAIRING_ENABLED=true
AGENTPOST_HUMAN_SELF_SERVICE_ENABLED=false
AGENTPOST_OPEN_REGISTRATION_ENABLED=false
AGENTPOST_REMOTE_MCP_OAUTH_ENABLED=false
AGENTPOST_ENTERPRISE_OIDC_ENABLED=false
# Comma-separated, operator-approved issuer identifiers; required when OIDC is enabled.
AGENTPOST_OIDC_ALLOWED_ISSUERS=
AGENTPOST_EMAIL_DELIVERY_MODE=test
# Required when self-service is enabled in production.
AGENTPOST_SMTP_HOST=
AGENTPOST_SMTP_PORT=587
AGENTPOST_SMTP_USERNAME=
AGENTPOST_SMTP_PASSWORD=
AGENTPOST_SMTP_FROM_ADDRESS=
AGENTPOST_SMTP_STARTTLS=true
AGENTPOST_MANAGED_AGENT_DOMAIN=agents.local
AGENTPOST_PUBLIC_BASE_URL=http://127.0.0.1:8000
AGENTPOST_REMOTE_MCP_RESOURCE_URL=http://127.0.0.1:8001/mcp
AGENTPOST_MCP_ALLOWED_HOSTS=127.0.0.1:8001,localhost:8001
AGENTPOST_MCP_ALLOWED_ORIGINS=http://127.0.0.1:8001
AGENTPOST_REGISTRATION_TOKEN=
# Required in production; leave unset to hide the debug admin surface in development.
AGENTPOST_ADMIN_TOKEN=
AGENTPOST_MAX_ATTACHMENT_BYTES=10485760
AGENTPOST_HUMAN_SESSION_TTL_SECONDS=43200
AGENTPOST_HUMAN_CONFIRMATION_TTL_SECONDS=300
AGENTPOST_APPROVAL_DEFAULT_TTL_SECONDS=86400
AGENTPOST_PAIRING_TTL_SECONDS=600
AGENTPOST_PAIRING_POLL_INTERVAL_SECONDS=5
AGENTPOST_EMAIL_CHALLENGE_TTL_SECONDS=600
AGENTPOST_EMAIL_CHALLENGE_COOLDOWN_SECONDS=60
AGENTPOST_EMAIL_CHALLENGE_MAX_ATTEMPTS=5
AGENTPOST_OIDC_STATE_TTL_SECONDS=600
AGENTPOST_OIDC_HTTP_TIMEOUT_SECONDS=10
