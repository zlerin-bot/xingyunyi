# Copy to a protected file outside a release directory, for example:
# /opt/agentpost/shared/agentpost.env
# Generate every *_CHANGE_ME value independently. Never commit the resulting file.

# Use :80 while validating the origin by IP. Change to agentpost.me only after DNS,
# ICP filing, and public HTTPS prerequisites are complete.
AGENTPOST_SITE_ADDRESS=:80
AGENTPOST_ACME_EMAIL=admin@example.com

POSTGRES_DB=agentpost
POSTGRES_USER=agentpost
POSTGRES_PASSWORD=CHANGE_ME_URL_SAFE_DATABASE_PASSWORD

AGENTPOST_ENVIRONMENT=production
AGENTPOST_LOG_LEVEL=INFO
AGENTPOST_API_KEY_PEPPER=CHANGE_ME_64_HEX_CHARACTERS
AGENTPOST_HUMAN_API_KEY_PEPPER=CHANGE_ME_DIFFERENT_64_HEX_CHARACTERS
AGENTPOST_CURSOR_SECRET=CHANGE_ME_64_HEX_CHARACTERS
AGENTPOST_PAIRING_SECRET=CHANGE_ME_DIFFERENT_64_HEX_CHARACTERS
AGENTPOST_HUMAN_AUTH_SECRET=CHANGE_ME_DIFFERENT_64_HEX_CHARACTERS
AGENTPOST_HUMAN_MFA_ENCRYPTION_KEY=CHANGE_ME_DIFFERENT_FERNET_DERIVATION_SECRET
AGENTPOST_OAUTH_TOKEN_PEPPER=CHANGE_ME_DIFFERENT_64_HEX_CHARACTERS
AGENTPOST_RATE_LIMIT_SECRET=CHANGE_ME_DIFFERENT_64_HEX_CHARACTERS
AGENTPOST_PAIRING_ENABLED=false
AGENTPOST_HUMAN_SELF_SERVICE_ENABLED=false
AGENTPOST_OPEN_REGISTRATION_ENABLED=false
AGENTPOST_REMOTE_MCP_OAUTH_ENABLED=false
AGENTPOST_EMAIL_DELIVERY_MODE=smtp
AGENTPOST_SMTP_HOST=smtp.example.com
AGENTPOST_SMTP_PORT=587
AGENTPOST_SMTP_USERNAME=CHANGE_ME
AGENTPOST_SMTP_PASSWORD=CHANGE_ME
AGENTPOST_SMTP_FROM_ADDRESS=no-reply@agentpost.me
AGENTPOST_SMTP_STARTTLS=true
AGENTPOST_SMTP_SSL=false
AGENTPOST_MANAGED_AGENT_DOMAIN=agentpost.me
AGENTPOST_PUBLIC_BASE_URL=https://agentpost.me
AGENTPOST_REMOTE_MCP_RESOURCE_URL=https://agentpost.me/mcp
AGENTPOST_MCP_ALLOWED_HOSTS=agentpost.me
AGENTPOST_MCP_ALLOWED_ORIGINS=https://agentpost.me
AGENTPOST_REGISTRATION_TOKEN=CHANGE_ME_64_HEX_CHARACTERS
AGENTPOST_ADMIN_TOKEN=CHANGE_ME_64_HEX_CHARACTERS
AGENTPOST_MAX_ATTACHMENT_BYTES=10485760
AGENTPOST_HUMAN_SESSION_TTL_SECONDS=43200
AGENTPOST_HUMAN_CONFIRMATION_TTL_SECONDS=300
AGENTPOST_APPROVAL_DEFAULT_TTL_SECONDS=86400
AGENTPOST_PAIRING_TTL_SECONDS=600
AGENTPOST_PAIRING_POLL_INTERVAL_SECONDS=5
AGENTPOST_EMAIL_CHALLENGE_IP_LIMIT=20
AGENTPOST_EMAIL_CHALLENGE_ADDRESS_LIMIT=5
AGENTPOST_EMAIL_CHALLENGE_RATE_WINDOW_SECONDS=3600
AGENTPOST_HUMAN_LOGIN_IP_LIMIT=60
AGENTPOST_HUMAN_LOGIN_ACCOUNT_LIMIT=10
AGENTPOST_HUMAN_LOGIN_RATE_WINDOW_SECONDS=900
AGENTPOST_PAIRING_CREATE_IP_LIMIT=30
AGENTPOST_PAIRING_POLL_IP_LIMIT=1200
AGENTPOST_PAIRING_RATE_WINDOW_SECONDS=3600
